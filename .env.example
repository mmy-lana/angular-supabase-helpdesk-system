# Local Docker Supabase (`supabase start`).
#
# The browser bundle needs the project URL and the publishable anon key; run
# `supabase status` and paste the two values below into
# src/environments/environment.development.ts. They are public credentials by
# design: row level security and the SECURITY DEFINER functions in
# supabase/migrations are what protect the data.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
